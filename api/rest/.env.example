APP_NAME=Marvel
PORT=9000
DEFAULT_CURRENCY=USD
# do not use / end of this SHOP_URL
SHOP_URL=http://localhost:3003
#### strip api key ---->

STRIPE_API_KEY=

# Payment -> Paypal
# Values: sandbox or live -> sanbox for development and live for production
PAYPAL_MODE=sandbox

#PayPal Setting & API Credentials - sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

#PayPal Setting & API Credentials - live
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

#### Email (SMTP) ---->

# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, secure
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Your Gmail address
SMTP_USER=
# Gmail App Password (enable 2FA, then create app password at myaccount.google.com/apppasswords)
SMTP_PASS=
# Sender name shown in emails (defaults to SMTP_USER)
MAIL_FROM=
# Where reset links point (no trailing slash)
FRONTEND_URL=https://switchgod.com.np
# Admin notification recipient (shop/order notifications)
ADMIN_EMAIL=mhzsajan@gmail.com
# Comma-separated emails that get super_admin permission on register (invite admins)
ADMIN_EMAILS=mhzsajan@gmail.com